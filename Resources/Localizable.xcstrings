{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "A label inside the circular gauge that shows the number of days left to race. The text is a placeholder and should be replaced with the actual number of days.",
      "isCommentAutoGenerated": true
    },
    "%@ · %@": {
      "comment": "A sublabel that includes the title of a work and a reference, separated by a dash.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
