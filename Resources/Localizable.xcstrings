    "sync_guide.step1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More (or your profile) → Settings → Connected Apps → Apple Health → Connect.\n\nAllow: Workouts, Walking + Running Distance, Sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más (o tu perfil) → Configuración → Aplicaciones conectadas → Salud → Conectar.\n\nPermite: Ejercicio, Distancia en carrera y caminata, Sueño."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais (ou seu perfil) → Configurações → Aplicativos conectados → Apple Saúde → Conectar.\n\nLibere: Exercícios, Distância de caminhada e corrida, Sono."
          }
        }
      }
    },
    "sync_guide.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Garmin Connect"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Garmin Connect"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Garmin Connect"
          }
        }
      }
    },
    "sync_guide.step2.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap your profile → Apps → Fudōshin → enable Workouts, Distance and Sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca tu perfil → Apps → Fudōshin → activa Ejercicio, Distancia y Sueño."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no seu perfil → Apps → Fudōshin → ative Exercícios, Distância e Sono."
          }
        }
      }
    },
