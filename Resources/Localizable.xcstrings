    "onboarding.health.desc": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "We read workouts and sleep to pick the right message." } },
        "es": { "stringUnit": { "state": "translated", "value": "Leemos entrenamientos y sueño para elegir el mensaje adecuado." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Lemos treinos e sono para escolher a mensagem certa." } }
      }
