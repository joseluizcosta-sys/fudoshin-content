    "sync_guide.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fudōshin reads your workouts and sleep from the Health app. If you use Garmin, Garmin Connect needs to send your data to Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fudōshin lee tus entrenamientos y sueño desde la app Salud. Si usas Garmin, Garmin Connect necesita enviar los datos a Salud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fudōshin lê seus treinos e seu sono pelo app Saúde. Se você usa Garmin, o Garmin Connect precisa enviar os dados para o Saúde."
          }
        }
      }
    },
