    "sync_guide.step3.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Garmin Connect to sync your watch. Without this, the workout won't reach Health and the post-workout message won't appear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Garmin Connect para sincronizar tu reloj. Sin esto, el entrenamiento no llega a Salud y el mensaje post-entrenamiento no aparecerá."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Garmin Connect para o relógio sincronizar. Sem isso, o treino não chega ao Saúde e a mensagem pós-treino não aparece."
          }
        }
      }
    },
