    "sync_guide.step1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More (or your profile) → Settings → Connected Apps → Apple Health → Connect.\n\nAllow: Workouts, Walking + Running Distance, Sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más (o tu perfil) → Configuración → Aplicaciones conectadas → Salud → Conectar.\n\nPermite: Ejercicio, Distancia en carrera y caminata, Sueño."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais (ou seu perfil) → Configurações → Aplicativos conectados → Apple Saúde → Conectar.\n\nLibere: Exercícios, Distância de caminhada e corrida, Sono."
          }
        }
      }
    },
